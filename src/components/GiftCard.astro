---
import type { Gift } from "../data/gifts";
import { categories } from "../data/gifts";

interface Props {
  gift: Gift;
}

const { gift } = Astro.props;

const priorityLabels = {
  1: { label: "Nice to have",    stars: "★☆☆", color: "text-gray-400 dark:text-gray-500" },
  2: { label: "Würde ich gerne", stars: "★★☆", color: "text-amber-400" },
  3: { label: "Sehr gerne!",     stars: "★★★", color: "text-amber-400" },
};

const cat = categories[gift.category];
const prio = priorityLabels[gift.priority];
---

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden flex flex-col hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
  {gift.image && (
    <div class="h-44 bg-gray-50 dark:bg-gray-900 flex items-center justify-center overflow-hidden">
      <img
        src={gift.image}
        alt={gift.name}
        loading="lazy"
        class="h-full w-full object-contain p-3"
      />
    </div>
  )}

  <div class="p-4 flex flex-col gap-2 flex-1">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-gray-900 dark:text-gray-100 text-base leading-tight">{gift.name}</h3>
      <span class={`shrink-0 text-xs font-medium px-2 py-0.5 rounded-full ${cat.darkColor}`}>
        {cat.emoji}
      </span>
    </div>

    {gift.description && (
      <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">{gift.description}</p>
    )}

    <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100 dark:border-gray-700">
      <span class={`text-sm font-medium ${prio.color}`} title={prio.label}>
        {prio.stars}
        <span class="text-gray-400 dark:text-gray-500 font-normal ml-1">{prio.label}</span>
      </span>

      {gift.link && (
        <a
          href={gift.link}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-indigo-400 hover:text-indigo-300 font-medium inline-flex items-center gap-1 transition-colors"
        >
          Ansehen
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
