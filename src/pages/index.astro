---
import Layout from "../layouts/Layout.astro";
import GiftCard from "../components/GiftCard.astro";
import { gifts, categories, type Category } from "../data/gifts";

const categoryOrder: Category[] = ["süßes", "salziges", "getränke", "sonstiges"];

const grouped = categoryOrder
  .map((cat) => ({
    key: cat,
    meta: categories[cat],
    items: gifts.filter((g) => g.category === cat),
  }))
  .filter((g) => g.items.length > 0);

const totalItems = gifts.length;
---

<Layout title="Timo's Wunschliste 🎁">
  <main class="max-w-4xl mx-auto px-4 py-12">

    <!-- Header -->
    <header class="mb-12 text-center">
      <div class="text-5xl mb-4">🎁</div>
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Timo's Wunschliste</h1>
      <p class="text-gray-500 text-lg">
        {totalItems} Dinge, die ich gerne hätte – von Snacks bis Getränken.
      </p>
    </header>

    <!-- Legend -->
    <div class="flex flex-wrap gap-3 justify-center mb-10">
      {categoryOrder.map((cat) => {
        const meta = categories[cat];
        return (
          <span class={`text-sm font-medium px-3 py-1.5 rounded-full ${meta.color}`}>
            {meta.emoji} {meta.label}
          </span>
        );
      })}
      <span class="text-sm px-3 py-1.5 rounded-full bg-gray-100 text-gray-600">
        ★★★ = Sehr gerne
      </span>
    </div>

    <!-- Sections per category -->
    {grouped.map(({ key, meta, items }) => (
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-gray-700 mb-5 flex items-center gap-2">
          <span>{meta.emoji}</span>
          <span>{meta.label}</span>
          <span class="ml-2 text-sm font-normal text-gray-400">({items.length})</span>
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((gift) => (
            <GiftCard gift={gift} />
          ))}
        </div>
      </section>
    ))}

    <footer class="text-center text-sm text-gray-400 mt-16 border-t border-gray-100 pt-8">
      Zuletzt aktualisiert: {new Date().toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" })}
    </footer>

  </main>
</Layout>
